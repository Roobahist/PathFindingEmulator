  "narrative": {
    "northStar": "The Textured Puzzle Workspace",
    "overview": "The Textured Puzzle Workspace places the original saturated puzzle artwork inside a dark, sleek control surface. Grass, water, lava, wood and stone supply the visual character; the interface uses quiet charcoal layers, readable labels and warm orange actions to make the artwork easy to inspect.\n\nThis records the shipped local browser interface. It replaces the rejected washed-out geometric presentation. Original raster textures remain the source of identity, while browser playback uses a large directional SVG arrow; the optional desktop interface is a separate retained presentation, not the source of these browser tokens.",
    "keyCharacteristics": [
      "Original texture artwork remains prominent and unchanged.",
      "Compact charcoal controls frame vivid puzzle imagery.",
      "IBM Plex Sans labels and tabular metrics support inspection.",
      "Orange identifies actions, selections and keyboard focus."
    ],
    "rules": [
      {
        "name": "The Original Artwork Rule",
        "body": "Use the supplied raster textures for puzzle tiles and artwork previews; preserve their bytes and their saturated character.",
        "section": "colors"
      },
      {
        "name": "The State Accent Rule",
        "body": "Orange marks primary actions, selected tools and keyboard focus; green reports positive status and pale coral reports errors.",
        "section": "colors"
      },
      {
        "name": "The Readable Control Rule",
        "body": "Use the bundled Plex face for browser controls; retain visible focus and text labels beside artwork choices.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve original tile and retained legacy directional sprite files byte-for-byte; use the SVG arrow for browser playback.",
      "Do pair artwork previews with accessible names and pressed states.",
      "Do maintain the visible orange focus outline and the board’s keyboard navigation.",
      "Do use truthful solver and playback messages based on the current engine result.",
      "Do disable motion under the user’s reduced-motion preference."
    ],
    "donts": [
      "Don't replace the original textures with washed-out geometric tiles.",
      "Don't use texture thumbnails as the only accessible label for a control.",
      "Don't report a board as cleared while boxes remain.",
      "Don't carry stale completion or solver results into an edited board."
    ]
  }
}
